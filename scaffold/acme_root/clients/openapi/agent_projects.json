{
  "components": {
    "schemas": {
      "AgentProjectView": {
        "properties": {
          "agent_workspace_base": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentWorkspaceBaseView"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "repository": {
            "$ref": "#/components/schemas/RepositoryView"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "updated_by": {
            "format": "uuid",
            "title": "Updated By",
            "type": "string"
          },
          "workspace_snapshots": {
            "title": "Workspace Snapshots",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "repository",
          "workspace_snapshots",
          "agent_workspace_base",
          "created_at",
          "created_by",
          "updated_at",
          "updated_by"
        ],
        "title": "AgentProjectView",
        "type": "object"
      },
      "AgentWorkspaceBaseBody": {
        "additionalProperties": false,
        "description": "The workspace base an agent project's sessions' workspaces start from: the\nimage, the commands that set it up, run once in order, and the package\nregistries the setup reaches. A setup that names a registry runs with\nopen egress; one that names none reaches nothing. Registries serve a\nsetup, so they come with one.",
        "properties": {
          "image": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]*$",
            "title": "Image",
            "type": "string"
          },
          "registries": {
            "items": {
              "maxLength": 253,
              "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$",
              "type": "string"
            },
            "maxItems": 20,
            "title": "Registries",
            "type": "array"
          },
          "setup": {
            "items": {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 50,
            "title": "Setup",
            "type": "array"
          }
        },
        "required": [
          "image"
        ],
        "title": "AgentWorkspaceBaseBody",
        "type": "object"
      },
      "AgentWorkspaceBaseView": {
        "properties": {
          "image": {
            "title": "Image",
            "type": "string"
          },
          "registries": {
            "items": {
              "type": "string"
            },
            "title": "Registries",
            "type": "array"
          },
          "setup": {
            "items": {
              "type": "string"
            },
            "title": "Setup",
            "type": "array"
          }
        },
        "required": [
          "image",
          "setup",
          "registries"
        ],
        "title": "AgentWorkspaceBaseView",
        "type": "object"
      },
      "CreateAgentProjectRequest": {
        "additionalProperties": false,
        "description": "An agent project and the one repository it binds, which never moves; whether\na kind that keeps its workspace by snapshots keeps it so here, False\nkeeping each of its sessions' workspaces a cache; and the workspace base\nits sessions' workspaces start from, if it names one.",
        "properties": {
          "agent_workspace_base": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentWorkspaceBaseBody"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "repository": {
            "$ref": "#/components/schemas/RepositoryBody"
          },
          "workspace_snapshots": {
            "default": true,
            "title": "Workspace Snapshots",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "repository"
        ],
        "title": "CreateAgentProjectRequest",
        "type": "object"
      },
      "FetchCredentialRequest": {
        "additionalProperties": false,
        "description": "A read-only credential of the agent project's repository, as source control\ntakes it over HTTPS. It goes to the tenant's store and is never read\nback.",
        "properties": {
          "password": {
            "format": "password",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^:\\s]+$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "FetchCredentialRequest",
        "type": "object"
      },
      "FetchCredentialView": {
        "description": "That the agent project's repository has a fetch credential, and who gave it\nwhen. Never its value.",
        "properties": {
          "agent_project_id": {
            "format": "uuid",
            "title": "Agent Project Id",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "updated_by": {
            "format": "uuid",
            "title": "Updated By",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "agent_project_id",
          "version",
          "updated_at",
          "updated_by"
        ],
        "title": "FetchCredentialView",
        "type": "object"
      },
      "RenameAgentProjectRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "RenameAgentProjectRequest",
        "type": "object"
      },
      "RepositoryBody": {
        "additionalProperties": false,
        "description": "A repository by its host's domain and its path there, such as\n`github.com` and `octo/reports`. Both are compared without case.",
        "properties": {
          "host": {
            "maxLength": 253,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$",
            "title": "Host",
            "type": "string"
          },
          "path": {
            "maxLength": 255,
            "pattern": "^[a-z0-9_][a-z0-9_.-]*(/[a-z0-9_][a-z0-9_.-]*)+$",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "host",
          "path"
        ],
        "title": "RepositoryBody",
        "type": "object"
      },
      "RepositoryView": {
        "properties": {
          "host": {
            "title": "Host",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "host",
          "path"
        ],
        "title": "RepositoryView",
        "type": "object"
      }
    }
  },
  "info": {
