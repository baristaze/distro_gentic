{
  "components": {
    "schemas": {
      "PoolLimitsView": {
        "description": "The pool's limits as the next claim reads them, at their version: 0\nwhile no operator wrote them, and the pool's options hold.",
        "properties": {
          "hibernated": {
            "title": "Hibernated",
            "type": "integer"
          },
          "most": {
            "title": "Most",
            "type": "integer"
          },
          "tenant_most": {
            "title": "Tenant Most",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          },
          "warm": {
            "title": "Warm",
            "type": "integer"
          }
        },
        "required": [
          "warm",
          "hibernated",
          "most",
          "tenant_most",
          "version",
          "updated_at"
        ],
        "title": "PoolLimitsView",
        "type": "object"
      },
      "SetPoolLimitsRequest": {
        "additionalProperties": false,
        "description": "The pool's limits, written whole: the VMs kept warm and running, those\nkept warm and hibernated where the VMs hibernate, none unless named, the\nmost VMs it holds at once, warm ones among them, and the most one tenant\nholds where no maximum of its own holds. The warm VMs, running and\nhibernated, stand below the most.",
        "properties": {
          "hibernated": {
            "default": 0,
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Hibernated",
            "type": "integer"
          },
          "most": {
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Most",
            "type": "integer"
          },
          "tenant_most": {
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Tenant Most",
            "type": "integer"
          },
          "warm": {
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Warm",
            "type": "integer"
          }
        },
        "required": [
          "warm",
          "most",
          "tenant_most"
        ],
        "title": "SetPoolLimitsRequest",
        "type": "object"
      },
      "SetTenantPoolLimitRequest": {
        "additionalProperties": false,
        "description": "A tenant's own maximum: the most VMs its sessions hold at once, in\nplace of the pool's `tenant_most`.",
        "properties": {
          "most": {
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Most",
            "type": "integer"
          }
        },
        "required": [
          "most"
        ],
        "title": "SetTenantPoolLimitRequest",
        "type": "object"
      },
      "TenantPoolLimitView": {
        "description": "A tenant's own maximum as the operator wrote it, at its version.",
        "properties": {
          "most": {
            "title": "Most",
            "type": "integer"
          },
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "updated_by": {
            "format": "uuid",
            "title": "Updated By",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "org_id",
          "most",
          "version",
          "updated_at",
          "updated_by"
        ],
        "title": "TenantPoolLimitView",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Acme API: cloud_pool",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/cloud-pool/limits": {
      "get": {
        "description": "The pool's limits as the next claim reads them. Requires the read\npermission.",
        "operationId": "get_pool_limits",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolLimitsView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Pool Limits",
        "tags": [
          "cloud_pool"
        ]
      },
      "put": {
        "description": "Writes the pool's limits, a new version, with an entry in the\nplatform's stream that names the operator and the values. The next\nclaim and the next refill hold to them; a VM already held stays.\nRequires the write permission.",
        "operationId": "set_pool_limits",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
