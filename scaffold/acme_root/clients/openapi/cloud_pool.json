              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Clear Tenant Pool Limit",
        "tags": [
          "cloud_pool"
        ]
      },
      "put": {
        "description": "Writes the org's own maximum of the pool's VMs, in place of the\npool's, with an entry in the org's stream that names the operator.\nRequires the write permission.",
        "operationId": "set_tenant_pool_limit",
        "parameters": [
          {
            "in": "path",
            "name": "org_id",
            "required": true,
            "schema": {
              "format": "uuid",
