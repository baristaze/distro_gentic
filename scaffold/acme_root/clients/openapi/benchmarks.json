{
  "components": {
    "schemas": {
      "BenchmarkSummaryView": {
        "description": "One run of a scenario, without its trials: a point of the scenario's\ntrend.",
        "properties": {
          "baseline": {
            "$ref": "#/components/schemas/ContenderPinView"
          },
          "baseline_result": {
            "$ref": "#/components/schemas/ContenderResultView"
          },
          "candidate": {
            "$ref": "#/components/schemas/ContenderPinView"
          },
          "candidate_result": {
            "$ref": "#/components/schemas/ContenderResultView"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "recorded_by": {
            "format": "uuid",
            "title": "Recorded By",
            "type": "string"
          },
          "regressed": {
            "title": "Regressed",
            "type": "boolean"
          },
          "scenario": {
            "title": "Scenario",
            "type": "string"
          }
        },
        "required": [
          "id",
          "scenario",
          "created_at",
          "candidate",
          "baseline",
          "candidate_result",
          "baseline_result",
          "regressed",
          "recorded_by"
        ],
        "title": "BenchmarkSummaryView",
        "type": "object"
      },
      "BenchmarkView": {
        "description": "One run of a scenario, with every trial of both contenders.",
        "properties": {
          "baseline": {
            "$ref": "#/components/schemas/ContenderPinView"
          },
          "baseline_result": {
            "$ref": "#/components/schemas/ContenderResultView"
          },
          "candidate": {
            "$ref": "#/components/schemas/ContenderPinView"
          },
          "candidate_result": {
            "$ref": "#/components/schemas/ContenderResultView"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "recorded_by": {
            "format": "uuid",
            "title": "Recorded By",
            "type": "string"
          },
          "regressed": {
            "title": "Regressed",
            "type": "boolean"
          },
          "scenario": {
            "title": "Scenario",
            "type": "string"
          },
          "trials": {
            "items": {
              "$ref": "#/components/schemas/TrialView"
            },
            "title": "Trials",
            "type": "array"
          }
        },
        "required": [
          "id",
          "scenario",
          "created_at",
          "candidate",
          "baseline",
          "candidate_result",
          "baseline_result",
          "regressed",
          "recorded_by",
          "trials"
        ],
        "title": "BenchmarkView",
        "type": "object"
      },
      "Contender": {
        "enum": [
          "candidate",
          "baseline"
        ],
        "title": "Contender",
        "type": "string"
      },
      "ContenderPinView": {
        "description": "What a contender's sessions ran: the agent kind, its version, and each model\nrole's fill.",
        "properties": {
          "fills": {
            "items": {
              "$ref": "#/components/schemas/RoleFillView"
            },
            "title": "Fills",
            "type": "array"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "kind_version": {
            "title": "Kind Version",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "kind_version",
          "fills"
        ],
        "title": "ContenderPinView",
        "type": "object"
      },
      "ContenderResultView": {
        "description": "One contender's result: its trials, how many passed, the mean of their\nscores, and the sum of their costs.",
        "properties": {
          "cost_micros": {
            "title": "Cost Micros",
            "type": "integer"
          },
          "passed": {
            "title": "Passed",
            "type": "integer"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "trials": {
            "title": "Trials",
            "type": "integer"
          }
        },
        "required": [
          "trials",
          "passed",
          "score",
          "cost_micros"
        ],
        "title": "ContenderResultView",
        "type": "object"
      },
      "RoleFillView": {
        "properties": {
          "fallbacks": {
            "items": {
              "$ref": "matrix.json#/components/schemas/FillView"
            },
            "title": "Fallbacks",
            "type": "array"
          },
          "fill": {
            "$ref": "matrix.json#/components/schemas/FillView"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "fill",
          "fallbacks"
        ],
        "title": "RoleFillView",
        "type": "object"
      },
      "TrialView": {
        "description": "One trial: its contender, its session, where and when it ran, its cost, and\nwhat its acceptance verdict found.",
        "properties": {
          "agent_session_id": {
            "format": "uuid",
            "title": "Agent Session Id",
            "type": "string"
          },
          "broken": {
            "items": {
              "type": "string"
            },
            "title": "Broken",
            "type": "array"
          },
          "contender": {
            "$ref": "#/components/schemas/Contender"
          },
          "cost_micros": {
            "title": "Cost Micros",
            "type": "integer"
          },
          "executor": {
            "title": "Executor",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "verdict_id": {
            "format": "uuid",
            "title": "Verdict Id",
            "type": "string"
          }
        },
        "required": [
          "contender",
          "agent_session_id",
          "executor",
          "started_at",
          "cost_micros",
          "verdict_id",
          "passed",
          "score",
          "broken"
        ],
        "title": "TrialView",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Acme API: benchmarks",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/benchmarks": {
      "get": {
        "description": "The scenario's runs, the newest first: each contender's score and cost, and\nwhether the candidate regressed.",
        "operationId": "get_trend",
        "parameters": [
          {
            "in": "query",
            "name": "scenario",
            "required": true,
            "schema": {
              "pattern": "^[a-z][a-z0-9_.-]{0,99}$",
              "title": "Scenario",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BenchmarkSummaryView"
                  },
                  "title": "Response Get Trend",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Trend",
        "tags": [
          "benchmarks"
        ]
      }
    },
    "/v1/admin/benchmarks/{benchmark_id}": {
      "get": {
        "operationId": "get_benchmark",
        "parameters": [
          {
            "in": "path",
            "name": "benchmark_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Benchmark Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenchmarkView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Benchmark",
        "tags": [
          "benchmarks"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "The operators' reads of the platform's benchmarks under\n/v1/admin/benchmarks: a scenario's runs, the newest first, which is its\ntrend, and one run with every trial. Each takes `OperatorContext` and the\nread permission; a benchmark belongs to no tenant.",
      "name": "benchmarks"
    }
  ]
}
