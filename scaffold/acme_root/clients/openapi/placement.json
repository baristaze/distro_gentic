{
  "components": {
    "schemas": {
      "AgentSessionStandingView": {
        "description": "Why a session is or is not moving. `changed_at` is its last change:\nwhen it parked, for a parked one. `concurrency` is the cap the claim\nholds its tenant to on the lane its loop stands on, or, with no loop,\nthe lane its next goes to: its own where `own_cap`, else the lane's.\n`pool_id` null is the cloud, where `hosts_online` is null; `share_set`\nfalse is the default tier.",
        "properties": {
          "agent_session_id": {
            "format": "uuid",
            "title": "Agent Session Id",
            "type": "string"
          },
          "changed_at": {
            "format": "date-time",
            "title": "Changed At",
            "type": "string"
          },
          "concurrency": {
            "title": "Concurrency",
            "type": "integer"
          },
          "hosts_online": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hosts Online"
          },
          "loop": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LoopStandingView"
              },
              {
                "type": "null"
              }
            ]
          },
          "own_cap": {
            "title": "Own Cap",
            "type": "boolean"
          },
          "own_lane": {
            "title": "Own Lane",
            "type": "boolean"
          },
          "park": {
            "anyOf": [
              {
                "$ref": "agent_sessions.json#/components/schemas/ParkView"
              },
              {
                "type": "null"
              }
            ]
          },
          "pending_input": {
            "title": "Pending Input",
            "type": "boolean"
          },
          "plan_tier": {
            "title": "Plan Tier",
            "type": "string"
          },
          "pool_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pool Id"
          },
          "share_set": {
            "title": "Share Set",
            "type": "boolean"
          },
          "status": {
            "$ref": "agent_sessions.json#/components/schemas/AgentSessionStatus"
          }
        },
        "required": [
          "agent_session_id",
          "status",
          "park",
          "changed_at",
          "pending_input",
          "plan_tier",
          "own_lane",
          "concurrency",
          "own_cap",
          "share_set",
          "pool_id",
          "hosts_online",
          "loop"
        ],
        "title": "AgentSessionStandingView",
        "type": "object"
      },
      "LoopStandingView": {
        "description": "The session's loop item made last, and its place in line:\n`ready_ahead` items of any tenant are ready before it on its lane, and\n`running_ahead` of its tenant's loops run ahead of it on that lane,\nwhich the claim holds to the tenant's cap there.",
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "available_at": {
            "format": "date-time",
            "title": "Available At",
            "type": "string"
          },
          "claimed_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claimed By"
          },
          "item_id": {
            "format": "uuid",
            "title": "Item Id",
            "type": "string"
          },
          "lane": {
            "title": "Lane",
            "type": "string"
          },
          "lease_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lease Expires At"
          },
          "max_attempts": {
            "title": "Max Attempts",
            "type": "integer"
          },
          "ready_ahead": {
            "title": "Ready Ahead",
            "type": "integer"
          },
          "running_ahead": {
            "title": "Running Ahead",
            "type": "integer"
          },
          "status": {
            "$ref": "work.json#/components/schemas/WorkStatus"
          }
        },
        "required": [
          "item_id",
          "status",
          "lane",
          "attempts",
          "max_attempts",
          "available_at",
          "claimed_by",
          "lease_expires_at",
          "ready_ahead",
          "running_ahead"
        ],
        "title": "LoopStandingView",
        "type": "object"
      },
      "ReportOutcome": {
        "enum": [
          "done",
          "failed"
        ],
        "title": "ReportOutcome",
        "type": "string"
      },
      "SetShareRequest": {
        "additionalProperties": false,
        "description": "A tenant's fair share: the plan tier whose lane its loops run in,\nwhether they run in a lane of their own instead, and how many of them\nrun at once there, its own cap, which holds in place of its tier's\nshare. With no `concurrency`, the tier's share holds.",
        "properties": {
          "concurrency": {
            "anyOf": [
              {
                "maximum": 10000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Concurrency"
          },
          "own_lane": {
            "default": false,
            "title": "Own Lane",
            "type": "boolean"
          },
          "plan_tier": {
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "title": "Plan Tier",
            "type": "string"
          }
        },
        "required": [
          "plan_tier"
        ],
        "title": "SetShareRequest",
        "type": "object"
      },
      "ShareView": {
        "description": "A tenant's fair share as the operator wrote it, at its version.\n`concurrency` is the most of its loops that run at once on its lane:\nits own cap where `own_cap`, else its tier's share.",
        "properties": {
          "concurrency": {
            "title": "Concurrency",
            "type": "integer"
          },
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          },
          "own_cap": {
            "title": "Own Cap",
            "type": "boolean"
          },
          "own_lane": {
            "title": "Own Lane",
            "type": "boolean"
          },
          "plan_tier": {
            "title": "Plan Tier",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "updated_by": {
            "format": "uuid",
            "title": "Updated By",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "org_id",
          "plan_tier",
          "own_lane",
          "concurrency",
          "own_cap",
          "version",
          "updated_at",
          "updated_by"
        ],
        "title": "ShareView",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Acme API: placement",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/orgs/{org_id}/agent-sessions/{agent_session_id}/standing": {
      "get": {
        "description": "Why the session is or is not moving: its park, its loop's lease and\nlane, its place in line, its tenant's share, and where it runs.",
        "operationId": "agent_session_standing",
        "parameters": [
          {
            "in": "path",
            "name": "org_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Org Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "agent_session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Agent Session Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSessionStandingView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Agent Session Standing",
        "tags": [
          "placement"
        ]
      }
    },
    "/v1/admin/orgs/{org_id}/share": {
      "put": {
        "description": "Writes the org's fair share, a new version, with an entry in the\norg's stream that names the operator. Its loops enqueued from then on go\nto the lane it names. `concurrency` is the org's own cap on that lane,\nwhich the claim holds in place of its tier's share; with none, the\ntier's share holds. Requires the write permission.",
        "operationId": "set_share",
        "parameters": [
          {
            "in": "path",
            "name": "org_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Org Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetShareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set Share",
        "tags": [
          "placement"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Placement: where each kind of a tenant's work runs. On the operator plane,\nunder /v1/admin/*, an operator who may write sets a tenant's fair share,\nits plan tier, its own lane, and how many of its loops run at once, a new\nversion each time, on the tenant's own record; the share is written whole,\nso the write is a PUT and a retry lands the same terms, with no\nIdempotency-Key. An operator who may read reads why a session is or is not\nmoving, as ids, counts, times, and states.\nEach route takes `OperatorContext` and names the tenant.",
      "name": "placement"
    }
  ]
}
