{
  "components": {
    "schemas": {
      "CostApprovalRequest": {
        "additionalProperties": false,
        "description": "A person's yes to the session's next call past its norm, up to a\nreference cost in millionths.",
        "properties": {
          "up_to_micros": {
            "exclusiveMinimum": 0.0,
            "maximum": 1000000000000000.0,
            "title": "Up To Micros",
            "type": "integer"
          }
        },
        "required": [
          "up_to_micros"
        ],
        "title": "CostApprovalRequest",
        "type": "object"
      },
      "EntryKind": {
        "enum": [
          "hold",
          "settlement",
          "charge",
          "credit",
          "grant",
          "raise",
          "approval"
        ],
        "title": "EntryKind",
        "type": "string"
      },
      "RaiseRequest": {
        "additionalProperties": false,
        "description": "A raise of a budget for the window open now: reference cost in\nmillionths, native tokens, or both. A unit left out is not raised, and\na raise raises one at least.",
        "properties": {
          "cost_micros": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 1000000000000000.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Micros"
          },
          "tokens": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 1000000000000000.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tokens"
          }
        },
        "title": "RaiseRequest",
        "type": "object"
      },
      "SpendLedgerEntryView": {
        "description": "One entry, written once. A field a kind does not carry is null:\n\n- `hold`: `agent_session_id`, `units` (the worst case, null when no price\n  applies), and `cost_micros` (the exposure).\n- `settlement`: `spend_hold_id`, `cost_micros` and `tokens` (what it spent).\n- `charge`: `spend_hold_id`, `units`, and `amount_micros` (what the money\n  buckets paid).\n- `credit`: `amount_micros` and `reference` (the payment's).\n- `grant`: `units`, `reason`, and `by` (the operator).\n- `raise`: `spend_budget_id`, `cost_micros`, `tokens`, and `by`.\n- `approval`: `agent_session_id`, `amount_micros` (the cost it allows), and\n  `by`.",
        "properties": {
          "agent_session_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Session Id"
          },
          "amount_micros": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Micros"
          },
          "by": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "By"
          },
          "cost_micros": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Micros"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/EntryKind"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference"
          },
          "spend_budget_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spend Budget Id"
          },
          "spend_hold_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spend Hold Id"
          },
          "tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tokens"
          },
          "units": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Units"
          }
        },
        "required": [
          "kind",
          "id",
          "created_at"
        ],
        "title": "SpendLedgerEntryView",
        "type": "object"
      },
      "SpendLedgerPageView": {
        "description": "One read of a tenant's ledger, the newest first. `has_more` says the\nread was cut at its limit and older entries match it too: narrow it by\nkind, hold, or session to reach them.",
        "properties": {
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/SpendLedgerEntryView"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "has_more"
        ],
        "title": "SpendLedgerPageView",
        "type": "object"
      },
      "SpendUnitsGrantRequest": {
        "additionalProperties": false,
        "description": "Units the platform grants the tenant for its life, and why.",
        "properties": {
          "reason": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "units": {
            "exclusiveMinimum": 0.0,
            "maximum": 1000000000000000.0,
            "title": "Units",
            "type": "integer"
          }
        },
        "required": [
          "units",
          "reason"
        ],
        "title": "SpendUnitsGrantRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Acme API: agent_billing",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/orgs/{org_id}/grants": {
      "post": {
        "description": "Units granted the tenant for its life, and why; its sessions parked\non its funds run again. An org that is gone is `404`.",
        "operationId": "grant_units",
        "parameters": [
          {
            "in": "path",
            "name": "org_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Org Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpendUnitsGrantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpendLedgerEntryView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Grant Units",
        "tags": [
          "agent_billing"
        ]
      }
    },
    "/v1/admin/orgs/{org_id}/spend-ledger": {
      "get": {
        "description": "The tenant's entries, the newest first, narrowed to one kind, one\nhold (its hold, settlement, and charge), or one session (its holds and\napprovals) when named. `has_more` says the read was cut at its limit.",
        "operationId": "get_ledger",
        "parameters": [
          {
            "in": "path",
            "name": "org_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Org Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/EntryKind"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "in": "query",
            "name": "spend_hold_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Spend Hold Id"
            }
          },
          {
            "in": "query",
            "name": "agent_session_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Agent Session Id"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpendLedgerPageView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Ledger",
        "tags": [
          "agent_billing"
        ]
      }
    },
    "/v1/agent-billing/payments": {
      "post": {
        "description": "The credit of a payment the provider confirmed: the body is the\nprovider's confirmation, byte for byte, and `Payment-Signature` its\nsignature. `webhook_signature_invalid` when the signature does not\ncheck out, and nothing is credited.",
        "operationId": "confirm_payment",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          },
          {
            "in": "header",
            "name": "Payment-Signature",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Payment-Signature"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpendLedgerEntryView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Confirm Payment",
        "tags": [
          "agent_billing"
        ]
      }
    },
    "/v1/agent-sessions/{agent_session_id}/cost-approval": {
      "post": {
        "description": "The session's next call past its norm, let through up to the cost\nnamed; the session parked on it runs again.",
        "operationId": "approve_call",
        "parameters": [
          {
            "in": "path",
            "name": "agent_session_id",
            "required": true,
