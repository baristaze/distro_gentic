        ]
      }
    },
    "/v1/provider-keys": {
      "get": {
        "description": "The tenant's keys, the newest first, a rotated or refused one among\nthem; never a value.",
        "operationId": "get_keys",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProviderKeyView"
                  },
                  "title": "Response Get Keys",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Keys",
        "tags": [
          "trust"
        ]
      }
    },
    "/v1/provider-keys/{provider}": {
      "put": {
        "description": "The tenant's live key to `provider`, the one before it rotated out.\nRequires managing the org. `key_refused` when the provider does not take\nit, and 503 when no probe can ask.",
        "operationId": "save_key",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "$ref": "matrix.json#/components/schemas/ProviderName"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveKeyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderKeyView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Save Key",
        "tags": [
          "trust"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "A tenant's own keys to its model providers. A key's value goes in and\nnever comes back: the routes answer the record alone, who added the key,\nwhen, its state, and when it was last used. A key is probed before it is\nsaved, and one the provider refuses is not saved. Saving mints a new\nreference and makes it the live key, so the write is a PUT, and a retry\nlands the same live value: it takes no Idempotency-Key.\n\nOn the operator plane, an operator who may read reads a session's shape,\nnever what it says. Its content opens only under a grant the grant job\nwrote in that tenant (`403 content_not_granted` otherwise), and the\ntenant's stream names the operator at every opening (ADR 2010).",
      "name": "trust"
    }
  ]
}
