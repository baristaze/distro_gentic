{
  "components": {
    "schemas": {
      "KeyStatus": {
        "enum": [
          "live",
          "rotated",
          "refused"
        ],
        "title": "KeyStatus",
        "type": "string"
      },
      "ProviderKeyView": {
        "description": "What the tenant sees of a key: its reference, who added it and when,\nits state, and when it was last used. Never its value.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_used_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          },
          "provider": {
            "$ref": "matrix.json#/components/schemas/ProviderName"
          },
          "status": {
            "$ref": "#/components/schemas/KeyStatus"
          }
        },
        "required": [
          "id",
          "provider",
          "status",
          "created_at",
          "created_by",
          "last_used_at"
        ],
        "title": "ProviderKeyView",
        "type": "object"
      },
      "SaveKeyRequest": {
        "additionalProperties": false,
        "description": "A key's value. It is written once, under a new reference, and no\nresponse, log, or error ever carries it.",
        "properties": {
          "value": {
            "format": "password",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Value",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "value"
        ],
        "title": "SaveKeyRequest",
        "type": "object"
      },
      "ShapePageView": {
        "description": "One page of a session's shape, after the seq the request named.",
        "properties": {
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/StepShapeView"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "has_more"
        ],
        "title": "ShapePageView",
        "type": "object"
      },
      "StepShapeView": {
        "description": "One step as an operator's `read` sees it: what it is, who wrote it,\nand the fields of its header a reader acts on, never what it says.\n`content` says whether what it says is kept.",
        "properties": {
          "actor": {
            "$ref": "agent_steps.json#/components/schemas/Actor"
          },
          "command": {
            "anyOf": [
              {
                "$ref": "agent_steps.json#/components/schemas/ControlCommand"
              },
              {
                "type": "null"
              }
            ]
          },
          "content": {
            "$ref": "agent_steps.json#/components/schemas/ContentState"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "agent_steps.json#/components/schemas/ToolFailure"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "loop_id": {
            "format": "uuid",
            "title": "Loop Id",
            "type": "string"
          },
          "origin": {
            "$ref": "agent_steps.json#/components/schemas/Origin"
          },
          "outcome": {
            "anyOf": [
              {
                "$ref": "agent_steps.json#/components/schemas/LoopOutcome"
              },
              {
                "type": "null"
              }
            ]
          },
          "park": {
            "anyOf": [
              {
                "$ref": "agent_sessions.json#/components/schemas/ParkView"
              },
              {
                "type": "null"
              }
            ]
          },
          "responds_to": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Responds To"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool"
          },
          "type": {
            "$ref": "agent_steps.json#/components/schemas/AgentStepType"
          }
        },
        "required": [
          "id",
          "seq",
          "loop_id",
          "type",
          "actor",
          "origin",
          "responds_to",
          "created_at",
          "content",
          "tool",
          "failure",
          "command",
          "park",
          "outcome"
        ],
        "title": "StepShapeView",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Acme API: trust",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/orgs/{org_id}/agent-sessions/{agent_session_id}/content": {
      "get": {
        "description": "The session's steps past `after_seq`, opened: only under a live\ncontent grant of the operator in that tenant, and each opening is an\nentry in the tenant's stream.",
        "operationId": "agent_session_content",
        "parameters": [
          {
            "in": "path",
            "name": "org_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Org Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "agent_session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Agent Session Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "after_seq",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "After Seq",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "agent_sessions.json#/components/schemas/AgentStepPageView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Agent Session Content",
        "tags": [
          "trust"
        ]
      }
    },
    "/v1/admin/orgs/{org_id}/agent-sessions/{agent_session_id}/shape": {
      "get": {
