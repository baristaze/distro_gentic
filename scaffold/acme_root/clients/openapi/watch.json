{
  "components": {
    "schemas": {
      "CommandPartView": {
        "properties": {
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "stream": {
            "title": "Stream",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "stream",
          "text"
        ],
        "title": "CommandPartView",
        "type": "object"
      },
      "CommandProgressView": {
        "description": "How a command stands: its state, its output after the last part read,\nand how it ended once it has. `refused` names why its host or the exec relay\nrefused it, such as a command a later run fenced.",
        "properties": {
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "parts": {
            "items": {
              "$ref": "#/components/schemas/CommandPartView"
            },
            "title": "Parts",
            "type": "array"
          },
          "refused": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refused"
          },
          "state": {
            "$ref": "exec_relay.json#/components/schemas/ExecState"
          },
          "stderr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stderr"
          },
          "stdout": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stdout"
          },
          "stopped": {
            "anyOf": [
              {
                "$ref": "exec_relay.json#/components/schemas/StopKind"
              },
              {
                "type": "null"
              }
            ]
          },
          "timed_out": {
            "default": false,
            "title": "Timed Out",
            "type": "boolean"
          },
          "truncated": {
            "default": false,
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "state",
          "parts"
        ],
        "title": "CommandProgressView",
        "type": "object"
      },
      "CommandRequest": {
        "additionalProperties": false,
        "description": "A command by hand: what it runs, where in the workspace, and how long\nit may take. Its key is the request's idempotency key.",
        "properties": {
          "argv": {
            "items": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 256,
            "minItems": 1,
            "title": "Argv",
            "type": "array"
          },
          "cwd": {
            "default": ".",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Cwd",
            "type": "string"
          },
          "timeout_seconds": {
            "default": 300,
            "exclusiveMinimum": 0.0,
            "maximum": 3600.0,
            "title": "Timeout Seconds",
            "type": "integer"
          }
        },
        "required": [
          "argv"
        ],
        "title": "CommandRequest",
        "type": "object"
      },
      "ControlGiveBackRequest": {
        "additionalProperties": false,
        "description": "What the person did, as the agent reads it on resume.",
        "properties": {
          "stop": {
            "default": false,
            "title": "Stop",
            "type": "boolean"
          },
          "summary": {
            "maxLength": 100000,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "summary"
        ],
        "title": "ControlGiveBackRequest",
        "type": "object"
      },
      "EntryView": {
        "description": "One numbered entry of a stream: its bytes in base64.",
        "properties": {
          "data": {
            "title": "Data",
            "type": "string"
          },
          "n": {
            "title": "N",
            "type": "integer"
          }
        },
        "required": [
          "n",
          "data"
        ],
        "title": "EntryView",
        "type": "object"
      },
      "HandRunView": {
        "description": "A command by hand as recorded: the item that holds what ran, the\nperson it is attributed to, and the writer epoch it runs under.",
        "properties": {
          "agent_session_id": {
            "format": "uuid",
            "title": "Agent Session Id",
            "type": "string"
          },
          "command_key": {
            "format": "uuid",
            "title": "Command Key",
            "type": "string"
          },
          "epoch": {
            "title": "Epoch",
            "type": "integer"
          },
          "item_id": {
            "format": "uuid",
            "title": "Item Id",
            "type": "string"
          },
          "state": {
            "$ref": "exec_relay.json#/components/schemas/ExecState"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "agent_session_id",
          "command_key",
          "user_id",
          "epoch",
          "state"
        ],
        "title": "HandRunView",
        "type": "object"
      },
      "ItemPageView": {
        "properties": {
          "item_id": {
            "format": "uuid",
            "title": "Item Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "streams": {
            "items": {
              "$ref": "#/components/schemas/ItemStreamView"
            },
            "title": "Streams",
            "type": "array"
          }
        },
        "required": [
          "item_id",
          "kind",
          "streams"
        ],
        "title": "ItemPageView",
        "type": "object"
      },
      "ItemReadView": {
        "description": "A handle to one item's streams of one kind until `expires_at`. Read\nit at `GET /v1/live/items?handle=`; a viewer asks for a new one when it\nends.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "handle": {
            "title": "Handle",
            "type": "string"
          },
          "item_id": {
            "format": "uuid",
            "title": "Item Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "kind",
          "handle",
          "expires_at"
        ],
        "title": "ItemReadView",
        "type": "object"
      },
      "ItemStreamView": {
        "description": "One open stream of the item: the oldest entry still held, the\nentries after the last one read, and whether entries never read were\nlet go.",
        "properties": {
          "dropped": {
            "title": "Dropped",
            "type": "boolean"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/EntryView"
            },
            "title": "Entries",
            "type": "array"
          },
          "first": {
            "title": "First",
            "type": "integer"
          },
          "stream": {
            "format": "uuid",
            "title": "Stream",
            "type": "string"
          }
        },
        "required": [
          "stream",
          "first",
          "dropped",
          "entries"
        ],
        "title": "ItemStreamView",
        "type": "object"
      },
      "LivePageView": {
        "properties": {
          "agent_session_id": {
            "format": "uuid",
            "title": "Agent Session Id",
            "type": "string"
          },
          "streams": {
            "items": {
              "$ref": "#/components/schemas/LiveStreamView"
            },
            "title": "Streams",
            "type": "array"
          }
        },
        "required": [
          "agent_session_id",
          "streams"
        ],
        "title": "LivePageView",
        "type": "object"
      },
      "LivePartView": {
        "description": "One part of a stream: its kind, its places, and its text. A part may\njoin a run of one block's parts: it holds the places from `n` to\n`last`, and a reader resumes after `last`. `index` is the block of a\nmodel response it belongs to; a tool call's input names the call, and a\ntool's output its channel.",
        "properties": {
          "channel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Channel"
          },
          "index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Index"
          },
          "kind": {
            "$ref": "#/components/schemas/PartKind"
          },
          "last": {
            "title": "Last",
            "type": "integer"
          },
          "n": {
            "title": "N",
            "type": "integer"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool"
          },
          "tool_use_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Use Id"
          }
        },
        "required": [
          "kind",
          "n",
          "last",
          "text"
        ],
        "title": "LivePartView",
        "type": "object"
      },
      "LiveReadView": {
        "description": "A handle to one session's open streams until `expires_at`. Read it\nat `GET /v1/live?handle=`; a viewer asks for a new one when it ends.",
        "properties": {
          "agent_session_id": {
            "format": "uuid",
            "title": "Agent Session Id",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "handle": {
            "title": "Handle",
            "type": "string"
          }
        },
        "required": [
          "agent_session_id",
          "handle",
          "expires_at"
        ],
        "title": "LiveReadView",
        "type": "object"
      },
      "LiveStreamView": {
        "description": "One open stream: the step it adds up to, the oldest part the service\nstill holds, the parts after the last one read, and whether parts never\nread were let go. The step holds them once it is stored.",
        "properties": {
          "agent_step_id": {
            "format": "uuid",
            "title": "Agent Step Id",
            "type": "string"
          },
          "dropped": {
            "title": "Dropped",
            "type": "boolean"
          },
          "first": {
            "title": "First",
            "type": "integer"
          },
          "parts": {
            "items": {
              "$ref": "#/components/schemas/LivePartView"
            },
            "title": "Parts",
            "type": "array"
          }
        },
        "required": [
          "agent_step_id",
          "first",
          "dropped",
          "parts"
        ],
        "title": "LiveStreamView",
        "type": "object"
      },
      "PartKind": {
        "enum": [
          "text",
          "thinking",
          "tool_input",
          "tool_output"
        ],
        "title": "PartKind",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Acme API: watch",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/agent-sessions/{agent_session_id}/control": {
      "post": {
        "description": "The person takes the session's environment: the agent stands down,\nits loop parked on a hand-over.",
        "operationId": "take_control",
        "parameters": [
          {
            "in": "path",
            "name": "agent_session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Agent Session Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "agent_sessions.json#/components/schemas/AgentSessionView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Take Control",
        "tags": [
          "watch"
        ]
      }
    },
    "/v1/agent-sessions/{agent_session_id}/control/commands": {
      "post": {
        "description": "A command by hand, recorded as the person's run and sent to the host\nthat holds the workspace. A retried send is the same run.",
        "operationId": "run_command",
        "parameters": [
          {
            "in": "path",
            "name": "agent_session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Agent Session Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HandRunView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Command",
        "tags": [
          "watch"
        ]
      }
    },
    "/v1/agent-sessions/{agent_session_id}/control/commands/{key}": {
      "get": {
        "description": "How the command stands: its output after `after_seq`, and how it\nended once it has.",
        "operationId": "command",
        "parameters": [
          {
            "in": "path",
            "name": "agent_session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Agent Session Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Key",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "after_seq",
            "required": false,
            "schema": {
              "default": -1,
              "minimum": -1,
              "title": "After Seq",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandProgressView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Command",
        "tags": [
          "watch"
        ]
      }
    },
    "/v1/agent-sessions/{agent_session_id}/control/give-back": {
      "post": {
        "description": "The person gives the environment back: their summary is the message\nthe agent reads on resume. A command of theirs still running refuses it,\nunless `stop` asks it stopped first.",
        "operationId": "give_back",
        "parameters": [
          {
            "in": "path",
            "name": "agent_session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Agent Session Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ControlGiveBackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "agent_sessions.json#/components/schemas/AgentSessionView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Give Back",
        "tags": [
          "watch"
        ]
      }
    },
    "/v1/agent-sessions/{agent_session_id}/live": {
      "post": {
        "description": "A handle to the session's open streams, for a viewer who may read it,\nthat lasts minutes.",
        "operationId": "open_live",
        "parameters": [
          {
            "in": "path",
            "name": "agent_session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Agent Session Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveReadView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Open Live",
        "tags": [
          "watch"
        ]
      }
    },
    "/v1/live": {
      "get": {
        "description": "The open streams of the handle's session, each after the last part\nread (`after=<agent_step_id>:<last>`, once a stream, the `last` of that part).\nThe handle is the authority: one that does not verify, or has expired,\nreads nothing.",
        "operationId": "read_live",
        "parameters": [
          {
            "in": "query",
            "name": "handle",
            "required": true,
            "schema": {
              "maxLength": 1024,
              "minLength": 1,
              "title": "Handle",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
