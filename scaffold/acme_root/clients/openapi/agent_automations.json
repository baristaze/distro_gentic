            },
            "title": "Integrations",
            "type": "array"
          },
          "kind": {
            "$ref": "#/components/schemas/TriggerKind"
          }
        },
        "required": [
          "kind",
          "integrations",
          "arrivals",
          "effects",
          "every"
        ],
        "title": "TriggerView",
        "type": "object"
      }
    }
