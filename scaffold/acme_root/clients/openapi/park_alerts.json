{
  "components": {
    "schemas": {
      "ParkAlertView": {
        "description": "What waits on the caller: the session, why it parked, the one action\nthat clears it, and that action's route, empty when none serves it yet.\n`read_at` is when the caller marked it read.",
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "agent_session_id": {
            "format": "uuid",
            "title": "Agent Session Id",
            "type": "string"
          },
          "channel": {
            "title": "Channel",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "link": {
            "title": "Link",
            "type": "string"
          },
          "provenance": {
            "anyOf": [
              {
                "$ref": "evidence.json#/components/schemas/Provenance"
              },
              {
                "type": "null"
              }
            ]
          },
          "read_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Read At"
          },
          "reason": {
            "$ref": "agent_steps.json#/components/schemas/ParkReason"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "unlock": {
            "title": "Unlock",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created_at",
          "agent_session_id",
          "reason",
          "unlock",
          "action",
          "link",
          "channel",
          "provenance",
          "text",
          "read_at"
        ],
        "title": "ParkAlertView",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Acme API: park_alerts",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/park-alerts": {
      "get": {
        "operationId": "list_park_alerts",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ParkAlertView"
                  },
                  "title": "Response List Park Alerts",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Park Alerts",
        "tags": [
          "park_alerts"
        ]
      }
    },
    "/v1/park-alerts/{park_alert_id}/read": {
      "post": {
        "description": "The park alert marked read; the first mark holds.",
        "operationId": "mark_read",
        "parameters": [
          {
            "in": "path",
            "name": "park_alert_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Park Alert Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParkAlertView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mark Read",
        "tags": [
          "park_alerts"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "The caller's own park alerts: what waits on them, newest first, and a\nmark that one is read. Nobody reads or marks another person's.",
      "name": "park_alerts"
    }
  ]
}
