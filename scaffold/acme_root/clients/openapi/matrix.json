{
  "components": {
    "schemas": {
      "BenchmarkResultRequest": {
        "additionalProperties": false,
        "description": "What a benchmark run showed of a model for a model role: whether it\npassed, and where its evidence is (`run`, such as the run's id or its\nreport's address). The latest result for the model and the role decides\nwhether a version that serves the role with the model may be\npublished.",
        "properties": {
          "benchmark": {
            "pattern": "^[a-z][a-z0-9_.-]{0,99}$",
            "title": "Benchmark",
            "type": "string"
          },
          "model": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderName"
          },
          "role": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "title": "Role",
            "type": "string"
          },
          "run": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Run",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "model",
          "role",
          "benchmark",
          "passed",
          "run"
        ],
        "title": "BenchmarkResultRequest",
        "type": "object"
      },
      "BenchmarkResultView": {
        "description": "A recorded result, written once.",
        "properties": {
          "benchmark": {
            "title": "Benchmark",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderName"
          },
          "recorded_by": {
            "format": "uuid",
            "title": "Recorded By",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "run": {
            "title": "Run",
            "type": "string"
          }
        },
        "required": [
          "id",
          "provider",
          "model",
          "role",
          "benchmark",
          "passed",
          "run",
          "created_at",
          "recorded_by"
        ],
        "title": "BenchmarkResultView",
        "type": "object"
      },
      "ChooseRequest": {
        "additionalProperties": false,
        "description": "The fill a tenant chooses for a model role: one of that role's\noptions.",
        "properties": {
          "fill": {
            "$ref": "#/components/schemas/FillBody"
          }
        },
        "required": [
          "fill"
        ],
        "title": "ChooseRequest",
        "type": "object"
      },
      "Effort": {
        "description": "How hard a model works on a call, as the wire names it: the\nproviders' own level, by value, held to theirs as `ProviderName` is.",
        "enum": [
          "none",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "title": "Effort",
        "type": "string"
      },
      "EligibilityBody": {
        "additionalProperties": false,
        "description": "What a fill offers: zero data retention, a region.",
        "properties": {
          "region": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "zero_retention": {
            "default": false,
            "title": "Zero Retention",
            "type": "boolean"
          }
        },
        "title": "EligibilityBody",
        "type": "object"
      },
      "EligibilityView": {
        "properties": {
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "zero_retention": {
            "title": "Zero Retention",
            "type": "boolean"
          }
        },
        "required": [
          "zero_retention",
          "region"
        ],
        "title": "EligibilityView",
        "type": "object"
      },
      "FillBody": {
        "additionalProperties": false,
        "description": "A fill: a provider's model, how hard it works and the efforts a kind's\nask may move it to (those its model takes), its output bound and shape,\nits context window, and what it offers. The output bound fits inside\nthe window, and a schema is named exactly when the output is one. An\noutput left out is text, an eligibility left out offers nothing, and\nefforts left out let no ask move the fill.",
        "properties": {
          "context_window": {
            "exclusiveMinimum": 0.0,
            "title": "Context Window",
            "type": "integer"
          },
          "effort": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Effort"
              },
              {
                "type": "null"
              }
            ]
          },
          "efforts": {
            "items": {
              "$ref": "#/components/schemas/Effort"
            },
            "maxItems": 6,
            "title": "Efforts",
            "type": "array"
          },
          "eligibility": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EligibilityBody"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_output_tokens": {
            "exclusiveMinimum": 0.0,
            "title": "Max Output Tokens",
            "type": "integer"
          },
          "model": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "output": {
            "anyOf": [
              {
                "$ref": "language_models.json#/components/schemas/OutputShape"
              },
              {
                "type": "null"
              }
            ]
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderName"
          },
          "schema_name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Name"
          },
          "thinking_budget": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thinking Budget"
          }
        },
        "required": [
          "provider",
          "model",
          "max_output_tokens",
          "context_window"
        ],
        "title": "FillBody",
        "type": "object"
      },
      "FillChoiceView": {
        "description": "The tenant's choice for one model role, from its next session on.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "fill": {
            "$ref": "#/components/schemas/FillView"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "updated_by": {
            "format": "uuid",
            "title": "Updated By",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "fill",
          "created_at",
          "updated_at",
          "updated_by"
        ],
        "title": "FillChoiceView",
        "type": "object"
      },
      "FillOptionsView": {
        "description": "What a tenant on its own keys may choose for one model role: the fills\nthe published matrix qualified for it, from a provider it holds a live\nkey for.",
        "properties": {
          "fills": {
            "items": {
              "$ref": "#/components/schemas/FillView"
            },
            "title": "Fills",
            "type": "array"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "fills"
        ],
        "title": "FillOptionsView",
        "type": "object"
      },
      "FillView": {
        "properties": {
          "context_window": {
            "title": "Context Window",
            "type": "integer"
          },
          "effort": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Effort"
              },
              {
                "type": "null"
              }
            ]
          },
          "efforts": {
            "items": {
              "$ref": "#/components/schemas/Effort"
            },
            "title": "Efforts",
            "type": "array"
          },
          "eligibility": {
            "$ref": "#/components/schemas/EligibilityView"
          },
          "max_output_tokens": {
            "title": "Max Output Tokens",
            "type": "integer"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "output": {
            "$ref": "language_models.json#/components/schemas/OutputShape"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderName"
          },
          "schema_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Name"
          },
          "thinking_budget": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thinking Budget"
          }
        },
        "required": [
          "provider",
          "model",
          "effort",
          "efforts",
          "thinking_budget",
          "max_output_tokens",
          "output",
          "schema_name",
          "context_window",
          "eligibility"
        ],
        "title": "FillView",
        "type": "object"
      },
      "MatrixKeyBody": {
        "additionalProperties": false,
        "description": "What a row answers: each key it names must equal the question's, and a\nkey left out matches every value. The row that names none matches every\nquestion. A row that names a model size answers only a role a kind asks\nthat size of: after a row that names the kind, and before the rest.",
        "properties": {
          "environment": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9-]{0,31}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Environment"
          },
          "kind": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind"
          },
          "plan_tier": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9-]{0,31}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Tier"
          },
          "role": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "size": {
            "anyOf": [
              {
                "$ref": "language_models.json#/components/schemas/ModelSize"
              },
              {
                "type": "null"
              }
            ]
          },
          "workload": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9-]{0,31}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workload"
          }
        },
        "title": "MatrixKeyBody",
        "type": "object"
      },
      "MatrixKeyView": {
        "properties": {
          "environment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Environment"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind"
          },
          "plan_tier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Tier"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "size": {
            "anyOf": [
              {
                "$ref": "language_models.json#/components/schemas/ModelSize"
              },
              {
                "type": "null"
              }
            ]
          },
          "workload": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workload"
          }
        },
        "required": [
          "environment",
          "size",
          "role",
          "kind",
          "plan_tier",
          "workload"
        ],
        "title": "MatrixKeyView",
        "type": "object"
      },
      "MatrixRowBody": {
        "additionalProperties": false,
        "description": "A row: the questions it matches, and its fills, the first the fill and\nthe rest the fallbacks, each named once. A row that names no match\nmatches every question.",
        "properties": {
          "fills": {
            "items": {
              "$ref": "#/components/schemas/FillBody"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Fills",
            "type": "array"
          },
          "matches": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MatrixKeyBody"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "fills"
        ],
        "title": "MatrixRowBody",
        "type": "object"
      },
      "MatrixRowView": {
        "description": "A row: the questions it matches, the row's key, and its fills.",
        "properties": {
          "fills": {
            "items": {
              "$ref": "#/components/schemas/FillView"
            },
            "title": "Fills",
            "type": "array"
          },
          "matches": {
            "$ref": "#/components/schemas/MatrixKeyView"
          }
        },
        "required": [
          "matches",
          "fills"
        ],
        "title": "MatrixRowView",
        "type": "object"
      },
      "MatrixStatus": {
        "enum": [
          "pending",
          "published"
        ],
        "title": "MatrixStatus",
        "type": "string"
      },
      "MatrixVersionView": {
        "description": "A version: pending until an operator publishes it, and the matrix from\nthen until the next is published. Its rows never change.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "published_by": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published By"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/MatrixRowView"
            },
            "title": "Rows",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/MatrixStatus"
          }
        },
        "required": [
          "id",
          "number",
          "roles",
          "rows",
          "status",
          "created_at",
          "created_by",
          "published_at",
          "published_by"
        ],
        "title": "MatrixVersionView",
        "type": "object"
      },
      "ProviderName": {
        "description": "A model provider, as the wire names it: the providers' own name, by\nvalue. A wire type lives in this layer, so the providers' enum is\nrepeated here, and a test holds the two to the same values.",
        "enum": [
          "anthropic",
          "openai"
        ],
        "title": "ProviderName",
        "type": "string"
      },
      "RetireRequest": {
        "additionalProperties": false,
        "description": "A model its provider retired, by name, as a fill names it.",
        "properties": {
          "model": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderName"
          }
        },
        "required": [
          "provider",
          "model"
        ],
        "title": "RetireRequest",
        "type": "object"
      },
      "RetirementView": {
        "description": "A retired model: no session resolves to it again, and a version that\nnames it is not published. Recorded once a model.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderName"
          },
          "recorded_by": {
            "format": "uuid",
            "title": "Recorded By",
            "type": "string"
          }
        },
        "required": [
          "id",
          "provider",
          "model",
          "created_at",
          "recorded_by"
        ],
        "title": "RetirementView",
        "type": "object"
      },
      "StageRequest": {
        "additionalProperties": false,
        "description": "A new version of the matrix: the model roles it serves and its rows,\none a key. It is checked whole when it is published.",
        "properties": {
          "roles": {
            "items": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "maxItems": 64,
            "minItems": 1,
            "title": "Roles",
            "type": "array"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/MatrixRowBody"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Rows",
            "type": "array"
          }
        },
        "required": [
          "roles",
          "rows"
        ],
        "title": "StageRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Acme API: matrix",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/matrix/results": {
      "post": {
        "description": "What a benchmark run showed of a model for a model role. The latest\nresult for the two decides whether a version that serves the role with\nthe model may be published.",
        "operationId": "record_result",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BenchmarkResultRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenchmarkResultView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Record Result",
        "tags": [
          "matrix"
        ]
      }
    },
    "/v1/admin/matrix/retirements": {
      "post": {
        "description": "A model its provider retired: no session resolves to it again, each\nsession on it switches at its next loop, and no version that names it\nis published. A model retired already answers its first record.",
        "operationId": "retire",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetireRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetirementView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
