{
  "components": {
    "schemas": {
      "StartValidationRequest": {
        "additionalProperties": false,
        "description": "A check the agent project's policy declares, to run at `head`, the delivered\ncommit, with the checks, fixtures, and runner taken from `base`. Each is\na commit's full id, never a name that moves.",
        "properties": {
          "agent_project_id": {
            "format": "uuid",
            "title": "Agent Project Id",
            "type": "string"
          },
          "base": {
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
            "title": "Base",
            "type": "string"
          },
          "check": {
            "pattern": "^[a-z][a-z0-9_.-]{0,99}$",
            "title": "Check",
            "type": "string"
          },
          "head": {
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
            "title": "Head",
            "type": "string"
          }
        },
        "required": [
          "agent_project_id",
          "check",
          "head",
          "base"
        ],
        "title": "StartValidationRequest",
        "type": "object"
      },
      "ValidationSessionView": {
        "description": "A validation session: what it runs, at which commit and from which,\nand where it stands. Once its run is recorded, `passed` is the verdict\nand `run` is that run; both are null while it waits. The run passes\nwhen it passed, at least one of its cases did, and what served it meets\nthe strictest grade the agent project's policy asks of the check, a twin when\nno requirement names it: a run on a double, or with a dependency that\nwas not there, never passes. A check a requirement rates runs its\ndeclared trials and passes only as that requirement judges them\ntogether, so one lucky trial never passes it; `run` is its last trial.\n`reason` says why it did not pass, and is null otherwise. A session\nwhose check cannot run here, for good, is `refused`: it never passes,\n`reason` says why it could not run, and `run` is null.",
        "properties": {
          "agent_project_id": {
            "format": "uuid",
            "title": "Agent Project Id",
            "type": "string"
          },
          "base": {
            "title": "Base",
            "type": "string"
          },
          "check": {
            "title": "Check",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "head": {
            "title": "Head",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "passed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passed"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "run": {
            "anyOf": [
              {
                "$ref": "evidence.json#/components/schemas/ExecutionView"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ValidationStatus"
          }
        },
        "required": [
          "id",
          "created_at",
          "created_by",
          "agent_project_id",
          "check",
          "head",
          "base",
          "status",
          "finished_at",
          "passed",
          "reason",
          "run"
        ],
        "title": "ValidationSessionView",
        "type": "object"
      },
      "ValidationStatus": {
        "enum": [
          "queued",
          "finished",
          "refused"
        ],
        "title": "ValidationStatus",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Acme API: platform_agents",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/validation-sessions": {
      "post": {
        "description": "A session queued for the platform's worker, which runs its check once.\n404 when the tenant holds no validation policy for the agent project; 422\nwhen the policy declares no such check.",
        "operationId": "start_validation",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationSessionView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Validation",
        "tags": [
          "platform_agents"
        ]
      }
    },
    "/v1/validation-sessions/{agent_session_id}": {
      "get": {
        "description": "The session: `queued` while its check waits or runs, `finished` with\nits verdict and its run once the run is recorded, and `refused` with its\nreason when its check cannot run here, for good.",
        "operationId": "get_validation",
        "parameters": [
          {
            "in": "path",
            "name": "agent_session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Agent Session Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationSessionView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Validation",
        "tags": [
          "platform_agents"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Validation sessions: one check of an agent project's policy, run on a fresh\nexecutor with no agent, started at a delivered commit under an\nIdempotency-Key, and read with its verdict once its run is recorded. A\nmember who may write starts one; any member reads one. Another tenant's\nsession, or its agent project, answers as one that never existed.",
      "name": "platform_agents"
    }
  ]
}
