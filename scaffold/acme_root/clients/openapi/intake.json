{
  "components": {
    "schemas": {
      "ConnectInstallationRequest": {
        "additionalProperties": false,
        "description": "The grant the system handed the person who installed the platform:\nthe integration reads the installation from it, never from the caller.",
        "properties": {
          "grant": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Grant",
            "type": "string"
          }
        },
        "required": [
          "grant"
        ],
        "title": "ConnectInstallationRequest",
        "type": "object"
      },
      "HandleKind": {
        "enum": [
          "pull_request",
          "branch"
        ],
        "title": "HandleKind",
        "type": "string"
      },
      "InstallationView": {
        "description": "An installation of the platform in a system, connected by the tenant:\nevery delivery that names it reaches this tenant alone.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "installation": {
            "title": "Installation",
            "type": "string"
          },
          "integration": {
            "title": "Integration",
            "type": "string"
          }
        },
        "required": [
          "id",
          "integration",
          "installation",
          "created_at",
          "created_by"
        ],
        "title": "InstallationView",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Acme API: intake",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/integrations/{integration}/installations": {
      "post": {
        "description": "The installation the grant names, connected to the tenant; connected\nalready, it answers as it stands.",
        "operationId": "connect_installation",
        "parameters": [
          {
            "in": "path",
            "name": "integration",
            "required": true,
            "schema": {
              "title": "Integration",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectInstallationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallationView"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "another tenant connected it"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Connect Installation",
        "tags": [
          "intake"
        ]
      }
    },
    "/webhooks/integrations/{name}": {
      "post": {
        "operationId": "integration_delivery",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/DeliveryReceivedView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Integration Delivery",
        "tags": [
          "intake"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "A tenant's connections: a person who manages the tenant connects a\nsystem's installation of the platform with the grant the system handed\nthem, and every delivery that names it reaches this tenant alone.",
      "name": "intake"
    }
  ]
}
