{
  "components": {
    "schemas": {
      "FindingView": {
        "description": "What one check found: advice for the person who published the\nlever, never a refusal. `excerpt` is the words it stands on.",
        "properties": {
          "check": {
            "$ref": "#/components/schemas/LeverCheck"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "excerpt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Excerpt"
          }
        },
        "required": [
          "check",
          "detail",
          "excerpt"
        ],
        "title": "FindingView",
        "type": "object"
      },
      "LeverCheck": {
        "description": "What a check found in a lever's text.",
        "enum": [
          "repeated_phrase",
          "contradiction",
          "unknown_name",
          "unbounded_retry",
          "past_session_bound"
        ],
        "title": "LeverCheck",
        "type": "string"
      },
      "LeverKind": {
        "enum": [
          "agent_playbook",
          "agent_knowledge"
        ],
        "title": "LeverKind",
        "type": "string"
      },
      "LeverReadingView": {
        "description": "The levers of one tenant's sessions created in `[since, until)`, best\nfirst. `complete` is false when the window held more sessions, or a\nsession more steps, than one reading reads.",
        "properties": {
          "complete": {
            "title": "Complete",
            "type": "boolean"
          },
          "sessions": {
            "title": "Sessions",
            "type": "integer"
          },
          "since": {
            "format": "date-time",
            "title": "Since",
            "type": "string"
          },
          "spun": {
            "title": "Spun",
            "type": "integer"
          },
          "standings": {
            "items": {
              "$ref": "#/components/schemas/LeverStandingView"
            },
            "title": "Standings",
            "type": "array"
          },
          "until": {
            "format": "date-time",
            "title": "Until",
            "type": "string"
          }
        },
        "required": [
          "since",
          "until",
          "sessions",
          "spun",
          "complete",
          "standings"
        ],
        "title": "LeverReadingView",
        "type": "object"
      },
      "LeverStandingView": {
        "description": "A lever against the window: of the sessions that reached it, how\nmany stalled, against the sessions that did not; `lift` is the first\nrate less the second; and the sessions that stalled with it, the first\nof them.",
        "properties": {
          "lever": {
            "$ref": "#/components/schemas/LeverView"
          },
          "lift": {
            "title": "Lift",
            "type": "number"
          },
          "sessions": {
            "title": "Sessions",
            "type": "integer"
          },
          "sessions_without": {
            "title": "Sessions Without",
            "type": "integer"
          },
          "spun": {
            "title": "Spun",
            "type": "integer"
          },
          "spun_sessions": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Spun Sessions",
            "type": "array"
          },
          "spun_without": {
            "title": "Spun Without",
            "type": "integer"
          }
        },
        "required": [
          "lever",
          "sessions",
          "spun",
          "sessions_without",
          "spun_without",
          "lift",
          "spun_sessions"
        ],
        "title": "LeverStandingView",
        "type": "object"
      },
      "LeverView": {
        "description": "One version of a lever as a session reached it, by its kind, its id,\nand its version: never its name or its slug, the tenant's words, which\nan operator who reads never sees.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/LeverKind"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "id",
          "version"
        ],
        "title": "LeverView",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Acme API: levers",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/orgs/{org_id}/levers": {
      "get": {
        "description": "The agent playbooks and agent knowledge the org's sessions created in `[since,\nuntil)` reached, ranked by how much more often the sessions that\nreached them stalled, with the sessions behind each figure. A stall is\nread from the steps' headers, never from what a step says, and a lever\nis answered by its kind, id, and version, never by its name or its\nslug. A window that does not end after it starts is `422`.",
        "operationId": "read_levers",
        "parameters": [
          {
            "in": "path",
            "name": "org_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Org Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "since",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "Since",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "until",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "Until",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeverReadingView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Levers",
        "tags": [
          "levers"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Levers: what a tenant's sessions reached before they stalled. On the\noperator plane, an operator who may read reads which levers a tenant's\nsessions created in a window reached, each lever by its kind, id, and\nversion, never its name or its slug, with counts and session ids (ADR\n2054).",
      "name": "levers"
    }
  ]
}
