{
  "components": {
    "schemas": {
      "AgentProjectRetentionBody": {
        "additionalProperties": false,
        "description": "What one agent project of the tenant narrows; it never widens the tenant's.",
        "properties": {
          "agent_project_id": {
            "format": "uuid",
            "title": "Agent Project Id",
            "type": "string"
          },
          "policy": {
            "$ref": "#/components/schemas/RetentionPolicyBody"
          }
        },
        "required": [
          "agent_project_id",
          "policy"
        ],
        "title": "AgentProjectRetentionBody",
        "type": "object"
      },
      "AgentProjectRetentionView": {
        "properties": {
          "agent_project_id": {
            "format": "uuid",
            "title": "Agent Project Id",
            "type": "string"
          },
          "policy": {
            "$ref": "#/components/schemas/RetentionPolicyView"
          }
        },
        "required": [
          "agent_project_id",
          "policy"
        ],
        "title": "AgentProjectRetentionView",
        "type": "object"
      },
      "CrossingKind": {
        "enum": [
          "enrollment",
          "claim",
          "stream_part",
          "artifact",
          "result"
        ],
        "title": "CrossingKind",
        "type": "string"
      },
      "KeyDestructionView": {
        "description": "A session's key destroyed, as the tenant's key service reported it:\nthe service, the key's name in it, when by its clock, and its receipt.\nNo key material crosses.",
        "properties": {
          "destroyed_at": {
            "format": "date-time",
            "title": "Destroyed At",
            "type": "string"
          },
          "key_name": {
            "title": "Key Name",
            "type": "string"
          },
          "receipt": {
            "title": "Receipt",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "service",
          "key_name",
          "destroyed_at",
          "receipt"
        ],
        "title": "KeyDestructionView",
        "type": "object"
      },
      "RetentionPolicyBody": {
        "additionalProperties": false,
        "description": "How long what a session says is kept, and its shape, each counted\nfrom the session's creation, none for no end; where its content may\nrest, sealed when left out; whether nothing it says may be kept\nanywhere; and its region. A field left out narrows nothing. A lifetime\npast a century, a content that outlives its shape, and zero retention\nthat keeps content at rest are refused.",
        "properties": {
          "content_lifetime": {
            "anyOf": [
              {
                "format": "duration",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Lifetime"
          },
          "region": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "shape_lifetime": {
            "anyOf": [
              {
                "format": "duration",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shape Lifetime"
          },
          "storage_mode": {
            "anyOf": [
              {
                "$ref": "privacy.json#/components/schemas/StorageMode"
              },
              {
                "type": "null"
              }
            ]
          },
          "zero_retention": {
            "default": false,
            "title": "Zero Retention",
            "type": "boolean"
          }
        },
        "title": "RetentionPolicyBody",
        "type": "object"
      },
      "RetentionPolicyView": {
        "properties": {
          "content_lifetime": {
            "anyOf": [
              {
                "format": "duration",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Lifetime"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "shape_lifetime": {
            "anyOf": [
              {
                "format": "duration",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shape Lifetime"
          },
          "storage_mode": {
            "$ref": "privacy.json#/components/schemas/StorageMode"
          },
          "zero_retention": {
            "title": "Zero Retention",
            "type": "boolean"
          }
        },
        "required": [
          "content_lifetime",
          "shape_lifetime",
          "storage_mode",
          "zero_retention",
          "region"
        ],
        "title": "RetentionPolicyView",
        "type": "object"
      },
      "RetentionRequest": {
        "additionalProperties": false,
        "description": "The tenant's whole policy, written over the version `If-Match` names,\nor, with no `If-Match`, as the tenant's first.",
        "properties": {
          "agent_projects": {
            "items": {
              "$ref": "#/components/schemas/AgentProjectRetentionBody"
            },
            "maxItems": 500,
            "title": "Agent Projects",
            "type": "array"
          },
          "policy": {
            "$ref": "#/components/schemas/RetentionPolicyBody"
          }
        },
        "title": "RetentionRequest",
        "type": "object"
      },
      "RetentionView": {
        "description": "The tenant's policy; version 0, the loosest, until its first write.",
        "properties": {
          "agent_projects": {
            "items": {
              "$ref": "#/components/schemas/AgentProjectRetentionView"
            },
            "title": "Agent Projects",
            "type": "array"
          },
          "policy": {
            "$ref": "#/components/schemas/RetentionPolicyView"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "updated_by": {
            "format": "uuid",
            "title": "Updated By",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "policy",
          "agent_projects",
          "version",
          "updated_at",
          "updated_by"
        ],
        "title": "RetentionView",
        "type": "object"
      },
      "SessionRetentionView": {
        "description": "One session's snapshot: the policy it took, when its content and its\nshape expire, and when each did. `destruction` is the key service's\nreport of the key it destroyed, none when the service holds the tenant's\nkey alone and the platform's revocation is the destruction.",
        "properties": {
          "agent_project_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Project Id"
          },
          "agent_session_id": {
            "format": "uuid",
            "title": "Agent Session Id",
            "type": "string"
          },
          "content_expired_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Expired At"
          },
          "content_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Expires At"
          },
          "destruction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/KeyDestructionView"
              },
              {
                "type": "null"
              }
            ]
          },
          "policy": {
            "$ref": "#/components/schemas/RetentionPolicyView"
          },
          "shape_expired_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shape Expired At"
          },
          "shape_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shape Expires At"
          }
        },
        "required": [
          "agent_session_id",
          "agent_project_id",
          "policy",
          "content_expires_at",
          "shape_expires_at",
          "content_expired_at",
          "destruction",
          "shape_expired_at"
        ],
        "title": "SessionRetentionView",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Acme API: retention",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/retention/policy": {
      "get": {
        "operationId": "get_policy",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetentionView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Policy",
        "tags": [
          "retention"
        ]
      },
      "put": {
        "description": "The policy as written, on the version `If-Match` names; with no\n`If-Match`, the tenant's first. `412 precondition_failed` when the\npolicy moved, or when a first meets one declared. Sessions created from\nnow on take it; existing ones take what it tightens at the next sweep,\nand nothing it loosens.",
        "operationId": "write_policy",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          },
          {
            "description": "The version the caller read, as an entity tag: `\"3\"`. 412 `precondition_failed` when the record changed since.",
            "in": "header",
            "name": "If-Match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The version the caller read, as an entity tag: `\"3\"`. 412 `precondition_failed` when the record changed since.",
              "title": "If-Match"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetentionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetentionView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Write Policy",
        "tags": [
          "retention"
        ]
      }
    },
    "/v1/retention/sessions/{agent_session_id}/erase": {
      "post": {
        "description": "Erases what the session said, for good: its key is revoked and\ndestroyed, and the audit holds the destruction. Its steps keep their\nplace, type, and shape, and read as saying nothing; the session takes no\ncontent again. A session marked deleted is erased too. Once: a second\ncall answers as the first left it. `404 not_found` for a session the\ntenant does not hold, which is how another tenant's reads.",
        "operationId": "erase_content",
        "parameters": [
          {
            "in": "path",
            "name": "agent_session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Agent Session Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRetentionView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Erase Content",
        "tags": [
          "retention"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "The tenant's retention: how long its sessions' content and shape are kept,\nand one session's content erased before then. Any member reads the policy;\nan owner or an admin writes it whole, on the version they read, and erases\na session's content.",
      "name": "retention"
    }
  ]
}
