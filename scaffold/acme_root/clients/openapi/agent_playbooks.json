{
  "components": {
    "schemas": {
      "AgentPlaybookView": {
        "description": "A version as published, with what the lever checks found in it as it\nwas: advice, which never refused the publish. `findings` is null on a\nversion the checks never read, one published before they ran, and an\nempty list on one they read and found nothing in.",
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "findings": {
            "anyOf": [
              {
                "items": {
                  "$ref": "levers.json#/components/schemas/FindingView"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Findings"
          },
          "gates": {
            "items": {
              "$ref": "#/components/schemas/GateView"
            },
            "title": "Gates",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "published_by": {
            "format": "uuid",
            "title": "Published By",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "description",
          "body",
          "gates",
          "published_by",
          "created_at",
          "findings"
        ],
        "title": "AgentPlaybookView",
        "type": "object"
      },
      "GateBody": {
        "additionalProperties": false,
        "description": "The calls a gate selects, by tool or by class, and what they need: a\nperson's approval, or a denial. A gate never allows.",
        "properties": {
          "authorization_class": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authorization Class"
          },
          "decision": {
            "$ref": "tools.json#/components/schemas/Decision"
          },
          "tool": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool"
          }
        },
        "required": [
          "decision"
        ],
        "title": "GateBody",
        "type": "object"
      },
      "GateView": {
        "properties": {
          "authorization_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authorization Class"
          },
          "decision": {
            "$ref": "tools.json#/components/schemas/Decision"
          },
          "tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool"
          }
        },
        "required": [
          "tool",
          "authorization_class",
          "decision"
        ],
        "title": "GateView",
        "type": "object"
      },
      "InvocationView": {
        "description": "A version brought into a session. `pinned` marks the kind manual the\nsession was made with, whose brief is its standing text; every other\ninvocation's brief arrived as its invoker's message.",
        "properties": {
          "agent_playbook_id": {
            "format": "uuid",
            "title": "Agent Playbook Id",
            "type": "string"
          },
          "agent_session_id": {
            "format": "uuid",
            "title": "Agent Session Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "invoked_by": {
            "format": "uuid",
            "title": "Invoked By",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "pinned": {
            "title": "Pinned",
            "type": "boolean"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "agent_session_id",
          "agent_playbook_id",
          "name",
          "version",
          "invoked_by",
          "pinned",
          "created_at"
        ],
        "title": "InvocationView",
        "type": "object"
      },
      "InvokeRequest": {
        "additionalProperties": false,
        "description": "The session a person brings the name's latest version into, one they\nmay instruct.",
        "properties": {
          "agent_session_id": {
            "format": "uuid",
            "title": "Agent Session Id",
            "type": "string"
          }
        },
        "required": [
          "agent_session_id"
        ],
        "title": "InvokeRequest",
        "type": "object"
      },
      "PinRequest": {
        "additionalProperties": false,
        "description": "A kind manual: the name whose latest version is pinned to `kind`,\nfor the tenant's sessions of it, or with `agent_project_id` those of one\nagent project, where it wins over the tenant's.",
        "properties": {
          "agent_project_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Project Id"
          },
          "kind": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "title": "PinRequest",
        "type": "object"
      },
      "PinView": {
        "description": "A version pinned to a kind as its kind manual. Each session of the kind\nmade after it was pinned holds it; one made before keeps its own.",
        "properties": {
          "agent_playbook_id": {
            "format": "uuid",
            "title": "Agent Playbook Id",
            "type": "string"
          },
          "agent_project_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Project Id"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "updated_by": {
            "format": "uuid",
            "title": "Updated By",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "kind",
          "agent_project_id",
          "agent_playbook_id",
          "name",
          "version",
          "created_at",
          "updated_at",
          "created_by",
          "updated_by"
        ],
        "title": "PinView",
        "type": "object"
      },
      "PublishRequest": {
        "additionalProperties": false,
        "description": "The next version of an agent playbook's name: its description, its body, and\nits gates.",
        "properties": {
          "body": {
            "maxLength": 50000,
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "description": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "gates": {
            "items": {
              "$ref": "#/components/schemas/GateBody"
            },
            "maxItems": 50,
            "title": "Gates",
            "type": "array"
          },
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "body"
        ],
        "title": "PublishRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Acme API: agent_playbooks",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/agent-playbook-pins": {
      "delete": {
        "description": "The kind's pin for the tenant, or for one agent project, taken away. A\nsession made with it keeps it.",
        "operationId": "unpin",
        "parameters": [
          {
            "in": "query",
            "name": "kind",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Kind",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "agent_project_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Agent Project Id"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PinView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Unpin",
        "tags": [
          "agent_playbooks"
        ]
      },
      "get": {
        "description": "The tenant's pins, by kind, the tenant's before an agent project's.",
        "operationId": "list_pins",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PinView"
                  },
                  "title": "Response List Pins",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Pins",
        "tags": [
          "agent_playbooks"
        ]
      },
      "put": {
        "description": "The name's latest version pinned to the kind as its kind manual, for the\ntenant or one agent project; pinned again, the version then latest.",
        "operationId": "pin",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PinView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Pin",
        "tags": [
          "agent_playbooks"
        ]
      }
    },
    "/v1/agent-playbooks": {
      "post": {
        "description": "The next version of the name.",
        "operationId": "publish",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentPlaybookView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Publish",
        "tags": [
          "agent_playbooks"
        ]
      }
    },
    "/v1/agent-playbooks/{name}": {
      "get": {
        "description": "The latest version of the name.",
        "operationId": "get_agent_playbook",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentPlaybookView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Agent Playbook",
        "tags": [
          "agent_playbooks"
        ]
      }
    },
    "/v1/agent-playbooks/{name}/invocations": {
      "post": {
        "description": "The latest version brought into the session: its gates hold there\nfrom now on, and its brief arrives as the caller's message. Invoked\nagain, the version's invocation answers, and nothing is sent twice.",
        "operationId": "invoke",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvokeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvocationView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Invoke",
        "tags": [
          "agent_playbooks"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "A tenant's agent playbooks: a person publishes a name's next version, in\nperson, and the latest version of a name is read. A person invokes the\nlatest version into a session they may instruct, and pins one to a kind\nas its kind manual, which each session of the kind made after holds.",
      "name": "agent_playbooks"
    }
  ]
}
