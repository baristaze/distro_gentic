{
  "components": {
    "schemas": {
      "AttachRequest": {
        "additionalProperties": false,
        "description": "A kind the connector joins, for one agent project's sessions or every\nsession of the tenant, deferred until the agent loads it unless\n`deferred` is false.",
        "properties": {
          "agent_project_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Project Id"
          },
          "deferred": {
            "default": true,
            "title": "Deferred",
            "type": "boolean"
          },
          "kind": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "title": "AttachRequest",
        "type": "object"
      },
      "AttachmentView": {
        "properties": {
          "agent_project_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Project Id"
          },
          "deferred": {
            "title": "Deferred",
            "type": "boolean"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "agent_project_id",
          "deferred"
        ],
        "title": "AttachmentView",
        "type": "object"
      },
      "ConnectRequest": {
        "additionalProperties": false,
        "description": "A server on the internet, at its `url`, whose calls carry their\ncredential in `credential_header`, after `credential_scheme`; or the\nserver the tenant's host runs, by the name its owner gives it,\n`host_server`, whose credential stays on that host.",
        "properties": {
          "credential_header": {
            "default": "Authorization",
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "title": "Credential Header",
            "type": "string"
          },
          "credential_scheme": {
            "default": "Bearer",
            "maxLength": 32,
            "title": "Credential Scheme",
            "type": "string"
          },
          "host_server": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Host Server"
          },
          "name": {
            "pattern": "^[a-z][a-z0-9_]{0,23}$",
            "title": "Name",
            "type": "string"
          },
          "summary": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "name",
          "summary"
        ],
        "title": "ConnectRequest",
        "type": "object"
      },
      "ConnectorPlace": {
        "description": "Where a connector's server runs, and so where its calls are made.",
        "enum": [
          "cloud",
          "host"
        ],
        "title": "ConnectorPlace",
        "type": "string"
      },
      "ConnectorReviewRequest": {
        "additionalProperties": false,
        "description": "Every tool a person binds, none to withdraw them all. A host server's\nreview carries the definitions its host lists.",
        "properties": {
          "definitions": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/DefinitionBody"
                },
                "maxItems": 1000,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Definitions"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ReviewedToolBody"
            },
            "maxItems": 64,
            "title": "Tools",
            "type": "array"
          }
        },
        "title": "ConnectorReviewRequest",
        "type": "object"
      },
      "ConnectorToolView": {
        "description": "A tool a person reviewed: the name a session calls it by, the\nserver's tool and the definition read, its class and its effect, and\nwhat the lever checks found in its description.",
        "properties": {
          "authorization_class": {
            "$ref": "tools.json#/components/schemas/ToolClass"
          },
          "definition_hash": {
            "title": "Definition Hash",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "effect": {
            "$ref": "tools.json#/components/schemas/Effect"
          },
          "findings": {
            "items": {
              "$ref": "levers.json#/components/schemas/FindingView"
            },
            "title": "Findings",
            "type": "array"
          },
          "input_schema": {
            "additionalProperties": true,
            "title": "Input Schema",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "server_tool": {
            "title": "Server Tool",
            "type": "string"
          }
        },
        "required": [
          "name",
          "server_tool",
          "description",
          "input_schema",
          "definition_hash",
          "authorization_class",
          "effect",
          "findings"
        ],
        "title": "ConnectorToolView",
        "type": "object"
      },
      "ConnectorView": {
        "description": "A connector: where its server runs, its address or its host's server,\nwhether its calls carry a credential, never the credential; the tools\na person reviewed at review `review`, its toolset's version; the kinds\nit is attached to; and `version`, which each write moves.",
        "properties": {
          "attachments": {
            "items": {
              "$ref": "#/components/schemas/AttachmentView"
            },
            "title": "Attachments",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "credential_header": {
            "title": "Credential Header",
            "type": "string"
          },
          "credential_scheme": {
            "title": "Credential Scheme",
            "type": "string"
          },
          "has_credential": {
            "title": "Has Credential",
            "type": "boolean"
          },
          "host_server": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Host Server"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "place": {
            "$ref": "#/components/schemas/ConnectorPlace"
          },
          "review": {
            "title": "Review",
            "type": "integer"
          },
          "reviewed_by": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewed By"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ConnectorToolView"
            },
            "title": "Tools",
            "type": "array"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "summary",
          "place",
          "url",
          "credential_header",
          "credential_scheme",
          "has_credential",
          "host_server",
          "tools",
          "review",
          "reviewed_by",
          "attachments",
          "version",
          "created_at",
          "updated_at"
        ],
        "title": "ConnectorView",
        "type": "object"
      },
      "CredentialRequest": {
        "additionalProperties": false,
        "description": "A cloud server's credential. It is written under the connector's own\nname, and no response, log, or error ever carries it.",
        "properties": {
          "value": {
            "format": "password",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Value",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "value"
        ],
        "title": "CredentialRequest",
        "type": "object"
      },
      "DefinitionBody": {
        "additionalProperties": false,
        "description": "A tool as a server lists it: its name, its description, its input\nschema, and its annotations, as written.",
        "properties": {
          "annotations": {
            "additionalProperties": true,
            "title": "Annotations",
            "type": "object"
          },
          "description": {
            "default": "",
            "maxLength": 10000,
            "title": "Description",
            "type": "string"
          },
          "input_schema": {
            "additionalProperties": true,
            "title": "Input Schema",
            "type": "object"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "DefinitionBody",
        "type": "object"
      },
      "ListedToolView": {
        "description": "A tool as the server lists it now, the hash a review names it by, and\nwhat the lever checks find in its description.",
        "properties": {
          "annotations": {
            "additionalProperties": true,
            "title": "Annotations",
            "type": "object"
          },
          "definition_hash": {
            "title": "Definition Hash",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "findings": {
            "items": {
              "$ref": "levers.json#/components/schemas/FindingView"
            },
            "title": "Findings",
            "type": "array"
          },
          "input_schema": {
            "additionalProperties": true,
            "title": "Input Schema",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "input_schema",
          "annotations",
          "definition_hash",
          "findings"
        ],
        "title": "ListedToolView",
        "type": "object"
      },
      "ReviewedToolBody": {
        "additionalProperties": false,
        "description": "A tool a person binds: the server's tool, the hash of the definition\nthey read, and the class and the effect they give it, each said\noutright: what a server says of its own tool is a hint, never\nauthority. A class that acts on the server's system waits for a person\nat each call, as any outward call does.",
        "properties": {
          "authorization_class": {
            "enum": [
              "read",
              "integration",
              "destructive"
            ],
            "title": "Authorization Class",
            "type": "string"
          },
          "definition_hash": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Definition Hash",
            "type": "string"
          },
          "effect": {
            "$ref": "tools.json#/components/schemas/Effect"
          },
          "server_tool": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Server Tool",
            "type": "string"
          }
        },
        "required": [
          "server_tool",
          "definition_hash",
          "authorization_class",
          "effect"
        ],
        "title": "ReviewedToolBody",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Acme API: connectors",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/connectors": {
      "get": {
        "description": "The tenant's connectors by id, after the id `after` names.",
        "operationId": "list_connectors",
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConnectorView"
                  },
                  "title": "Response List Connectors",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Connectors",
        "tags": [
          "connectors"
        ]
      },
      "post": {
        "description": "A server connected, with no credential and no tool reviewed. Requires\nmanaging the org. A cloud address that is this host or a private\nnetwork is refused.",
        "operationId": "connect_server",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Connect Server",
        "tags": [
          "connectors"
        ]
      }
    },
    "/v1/connectors/{connector_id}": {
      "get": {
        "operationId": "get_connector",
        "parameters": [
          {
            "in": "path",
            "name": "connector_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Connector Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Connector",
        "tags": [
          "connectors"
        ]
      }
    },
    "/v1/connectors/{connector_id}/attachments": {
      "delete": {
        "description": "The attachment of `kind` and `agent_project_id` taken away. A session that\npinned the connector keeps it.",
        "operationId": "detach",
        "parameters": [
          {
            "in": "path",
            "name": "connector_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Connector Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": true,
            "schema": {
              "title": "Kind",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "agent_project_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Agent Project Id"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Detach",
        "tags": [
          "connectors"
        ]
      },
      "post": {
        "description": "The connector attached to a kind: an attachment of that kind and\nagent project already held is replaced.",
        "operationId": "attach",
        "parameters": [
          {
            "in": "path",
            "name": "connector_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Connector Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttachRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Attach",
        "tags": [
          "connectors"
        ]
      }
    },
    "/v1/connectors/{connector_id}/credential": {
      "put": {
        "description": "A cloud server's credential, written over the last one; a session's\nnext call carries it. Requires managing the org. A host's server keeps\nits credential on its host: 422.",
        "operationId": "put_credential",
        "parameters": [
          {
            "in": "path",
            "name": "connector_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Connector Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
