{
  "components": {
    "schemas": {
      "ControlKind": {
        "description": "What one line of a host's control stream says.",
        "enum": [
          "wake",
          "ping",
          "cancel",
          "interrupt",
          "deadline",
          "revoke"
        ],
        "title": "ControlKind",
        "type": "string"
      },
      "ControlView": {
        "description": "One line of a host's control stream. `wake` asks it to claim now,\n`ping` keeps the stream open, and the rest end the item named at once.",
        "properties": {
          "id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "item_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item Id"
          },
          "kind": {
            "$ref": "#/components/schemas/ControlKind"
          }
        },
        "required": [
          "kind"
        ],
        "title": "ControlView",
        "type": "object"
      },
      "CrossingBody": {
        "additionalProperties": false,
        "description": "What the sender declares of the bytes it sends: what they are, their\nSHA-256 in hex, and their size.",
        "properties": {
          "kind": {
            "$ref": "retention.json#/components/schemas/CrossingKind"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "size": {
            "minimum": 0.0,
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "sha256",
          "size"
        ],
        "title": "CrossingBody",
        "type": "object"
      },
      "ExecDetailView": {
        "description": "An item the host holds: the call, the workspace, and the operation.",
        "properties": {
          "agent_session_id": {
            "format": "uuid",
            "title": "Agent Session Id",
            "type": "string"
          },
          "call_id": {
            "format": "uuid",
            "title": "Call Id",
            "type": "string"
          },
          "deadline": {
            "format": "date-time",
            "title": "Deadline",
            "type": "string"
          },
          "effect": {
            "title": "Effect",
            "type": "string"
          },
          "epoch": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Epoch"
          },
          "item_id": {
            "format": "uuid",
            "title": "Item Id",
            "type": "string"
          },
          "location": {
            "title": "Location",
            "type": "string"
          },
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          },
          "request": {
            "additionalProperties": true,
            "title": "Request",
            "type": "object"
          },
          "spec": {
            "additionalProperties": true,
            "title": "Spec",
            "type": "object"
          }
        },
        "required": [
          "item_id",
          "call_id",
          "org_id",
          "agent_session_id",
          "effect",
          "deadline",
          "epoch",
          "spec",
          "location",
          "request"
        ],
        "title": "ExecDetailView",
        "type": "object"
      },
      "ExecLeaseView": {
        "properties": {
          "lease_expires_at": {
            "format": "date-time",
            "title": "Lease Expires At",
            "type": "string"
          }
        },
        "required": [
          "lease_expires_at"
        ],
        "title": "ExecLeaseView",
        "type": "object"
      },
      "ExecState": {
        "enum": [
          "queued",
          "running",
          "done",
          "interrupted"
        ],
        "title": "ExecState",
        "type": "string"
      },
      "OutputStream": {
        "enum": [
          "stdout",
          "stderr"
        ],
        "title": "OutputStream",
        "type": "string"
      },
      "PartRequest": {
        "additionalProperties": false,
        "description": "One part of an item's output: its place in it, and its stream. A host\nwhose pushes hold one part each sends it alone, as a push of that part,\nand it lands as one while the floor of `exec` work takes that host.",
        "properties": {
          "crossing": {
            "$ref": "#/components/schemas/CrossingBody"
          },
          "data": {
            "maxLength": 170668,
            "title": "Data",
            "type": "string"
          },
          "seq": {
            "minimum": 0.0,
            "title": "Seq",
            "type": "integer"
          },
          "stream": {
            "$ref": "#/components/schemas/OutputStream"
          }
        },
        "required": [
          "seq",
          "stream",
          "data",
          "crossing"
        ],
        "title": "PartRequest",
        "type": "object"
      },
      "PartsRequest": {
        "additionalProperties": false,
        "description": "The parts of an item's output one flush window gathered, in the order\nthe host read them: one push, held to its bytes before any is decoded.",
        "properties": {
          "parts": {
            "items": {
              "$ref": "#/components/schemas/PartRequest"
            },
            "maxItems": 256,
            "minItems": 1,
            "title": "Parts",
            "type": "array"
          }
        },
        "required": [
          "parts"
        ],
        "title": "PartsRequest",
        "type": "object"
      },
      "PrepareRequest": {
        "additionalProperties": false,
        "description": "A host's answer to a prepare it claimed: where on it the workspace it\nmade is, or why it made none. Exactly one of the two. A refusal is\n`lost` when the snapshot the host was asked to start it from is not in\nits store, or is altered there, and `unbuilt` when the base the\nworkspace starts from failed to build on the host.",
        "properties": {
          "location": {
            "anyOf": [
              {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "lost": {
            "default": false,
            "title": "Lost",
            "type": "boolean"
          },
          "refused": {
            "anyOf": [
              {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refused"
          },
          "unbuilt": {
            "default": false,
            "title": "Unbuilt",
            "type": "boolean"
          }
        },
        "title": "PrepareRequest",
        "type": "object"
      },
      "PreparedView": {
        "description": "Whether the session's workspace is now the one this host made. When\nit is not, another host of the pool holds it, and this host lets its\nown go.",
        "properties": {
          "held": {
            "title": "Held",
            "type": "boolean"
          }
        },
        "required": [
          "held"
        ],
        "title": "PreparedView",
        "type": "object"
      },
      "ResultRequest": {
        "additionalProperties": false,
        "description": "How an item ended: the JSON of an exec result, in base64.",
        "properties": {
          "crossing": {
            "$ref": "#/components/schemas/CrossingBody"
          },
          "data": {
            "maxLength": 16000000,
            "title": "Data",
            "type": "string"
          }
        },
        "required": [
          "data",
          "crossing"
        ],
        "title": "ResultRequest",
        "type": "object"
      },
      "SnapshotRequest": {
        "additionalProperties": false,
        "description": "A host's answer to a snapshot it claimed: kept in its own store, under\nthe reference the store knows it by, with the SHA-256 of its bytes and\ntheir size, never the bytes; or why it kept none. Exactly one of the\ntwo.",
        "properties": {
          "digest": {
            "anyOf": [
              {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Digest"
          },
          "reference": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference"
          },
          "refused": {
            "anyOf": [
              {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refused"
          },
          "size": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size"
          }
        },
        "title": "SnapshotRequest",
        "type": "object"
      },
      "StopKind": {
        "description": "What the control stream tells a host about one item it holds. Each\nends the command at once.",
        "enum": [
          "cancel",
          "interrupt",
          "deadline",
          "revoke"
        ],
        "title": "StopKind",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Acme API: exec_relay",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/hosts/me/control": {
      "get": {
        "description": "The host's control stream, after the message `after` names.",
        "operationId": "control",
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          },
          {
            "in": "header",
            "name": "x-app",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App"
            }
          },
          {
            "in": "header",
            "name": "x-app-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-App-Version"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlView"
                }
              },
              "application/x-ndjson": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.json#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Control",
        "tags": [
          "exec_relay"
        ]
      }
    },
    "/v1/hosts/me/exec/{item_id}": {
