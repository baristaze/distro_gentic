# The workspace host's settings on Linux: /etc/acme-host/host.env, owned by
# root, mode 600. install.sh writes it once, from its flags, and never
# overwrites it. systemd reads it as root; the host's own user cannot.

# The platform it serves, and the name it enrolls under.
ACME_API_URL=https://api.acme.example
ACME_HOST_NAME=

# The first start only: the token its owner issued. Once the host holds its
# credential, the token is spent, and this line can go.
ACME_ENROLLMENT_TOKEN=

# The machine's egress, when it has a proxy and a CA of its own. The CA file
# must be readable by the host's user, e.g. /etc/acme-host/ca.pem, mode 644.
# HTTPS_PROXY=http://proxy.internal:3128
# NO_PROXY=localhost,127.0.0.1
# SSL_CERT_FILE=/etc/acme-host/ca.pem

# The image a container workspace runs (default python:3.14).
# ACME_HOST_WORKSPACE_IMAGE=python:3.14
