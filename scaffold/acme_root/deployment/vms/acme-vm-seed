#!/bin/sh
# Writes the cloud's first-boot data, the seed the cloud pool handed this
# VM, to /run/acme-vm/seed.json for the host's user alone. It asks
# the metadata endpoint with a session token (IMDSv2), and does nothing when
# the endpoint does not answer.
set -eu
dir=/run/acme-vm
endpoint=http://169.254.169.254/latest
token=$(curl -sf -m 5 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' \
  "$endpoint/api/token") || exit 0
umask 077
install -d -m 0700 -o acme-host -g acme-host "$dir"
curl -sf -m 5 -H "X-aws-ec2-metadata-token: $token" "$endpoint/user-data" \
  > "$dir/seed.json.partial" || { rm -f "$dir/seed.json.partial"; exit 0; }
chown acme-host:acme-host "$dir/seed.json.partial"
mv "$dir/seed.json.partial" "$dir/seed.json"
