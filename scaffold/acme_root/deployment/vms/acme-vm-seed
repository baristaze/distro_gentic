#!/bin/sh
# Writes the cloud's first-boot data, the seed the cloud pool handed this
# VM, to /run/acme-vm/seed.json for the host's user alone, then routes the
# VM's lookups by it (acme-vm-dns). It asks the metadata endpoint with a
# session token (IMDSv2), and does nothing when the endpoint does not answer.
# Its one argument is how many times it asks again for the token, a second
# apart: none at boot, where the network is up first, and some after a
# resume, where it comes back a moment later.
set -eu
retries=${1:-0}
dir=/run/acme-vm
endpoint=http://169.254.169.254/latest
token=$(curl -sf -m 5 --retry "$retries" --retry-delay 1 --retry-all-errors \
  -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' \
  "$endpoint/api/token") || exit 0
umask 077
install -d -m 0700 -o acme-host -g acme-host "$dir"
curl -sf -m 5 -H "X-aws-ec2-metadata-token: $token" "$endpoint/user-data" \
  > "$dir/seed.json.partial" || { rm -f "$dir/seed.json.partial"; exit 0; }
chown acme-host:acme-host "$dir/seed.json.partial"
mv "$dir/seed.json.partial" "$dir/seed.json"
/usr/local/libexec/acme-vm-dns "$dir/seed.json"
