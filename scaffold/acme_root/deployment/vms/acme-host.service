# The host program in a VM of the cloud pool. It starts once the pool's
# seed is on /run (acme-vm-seed.service reads it from the cloud's
# first-boot data; on Lima the pool writes it and restarts this unit), runs
# as its own user in Docker's group, so its session's commands build and run
# containers, and keeps its home on /run, so no credential reaches the disk.
[Unit]
Description=Acme host of a VM of the cloud pool
After=network-online.target docker.service acme-vm-seed.service
Wants=network-online.target
ConditionPathExists=/run/acme-vm/seed.json

[Service]
Type=simple
User=acme-host
Group=acme-host
SupplementaryGroups=docker
EnvironmentFile=/etc/acme-host/host.env
RuntimeDirectory=acme-host
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStartPre=+/usr/bin/install -o acme-host -g acme-host -m 0400 /etc/acme-host/ceilings.toml /run/acme-host/ceilings.toml
ExecStart=/opt/acme-host/venv/bin/acme-host run
# 1 refused, 2 a setting is wrong, 3 not enrolled, 5 a probe a person must
# fix: the pool's sweep stops the VM once its host is silent, and its
# session's next loop starts it again with a new seed. Anything else passes
# with time.
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=1 2 3 5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
