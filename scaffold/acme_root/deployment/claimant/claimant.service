# A claimant on a tenant's Linux machine: the workspace host, or a product's
# claimant of its own kind. deployment/claimant/install.sh renders this
# template to /etc/systemd/system/@UNIT@.service, each @NAME@ replaced by the
# kind's unit, user, kind, the variable its home is read from, and the groups
# its drop-ins grant. It runs as its own system user, never root, from a
# release root owns, and reaches nothing of the machine beyond its own state:
# the platform over the network, and what a drop-in of its kind's grants it.
# A kind's drop-ins, in @UNIT@.service.d/, add to these walls; the host's
# check reads their exposure with `systemd-analyze security`.
[Unit]
Description=Acme claimant @UNIT@, of the kind @KIND@
After=network-online.target
Wants=network-online.target
# After a rootful engine's socket, where one exists, so that the wall below
# covers it from the claimant's first start.
After=docker.socket docker.service containerd.service

[Service]
Type=simple
User=@USER@
Group=@USER@
# The platform's URL, the name it enrolls under, the first start's enrollment
# token, and the machine's proxy and CA file. Root reads it before the
# claimant starts; the claimant's own user cannot read it.
EnvironmentFile=/etc/@UNIT@/@KIND@.env
Environment=@HOME_VARIABLE@=/var/lib/@UNIT@
Environment=HOME=/var/lib/@UNIT@
WorkingDirectory=/var/lib/@UNIT@
# The claimant, started only while its user holds no group beyond its own
# and the ones its kind's drop-ins grant with SupplementaryGroups=
# (own-group-only.sh says why). @GRANTED@ is a --granted for each such group,
# or nothing when they grant none.
ExecStart=/opt/@UNIT@/own-group-only.sh@GRANTED@ /opt/@UNIT@/current/bin/@COMMAND@ run
# 1 refused, 2 a setting or a file is wrong, 3 not enrolled, 5 a startup
# probe failed that a person must fix, 6 its user is in a group neither its
# own nor granted, 226 its walls could not be set up (a file a drop-in binds
# is missing): a person must act, so systemd does not spin on them. A
# platform unreachable or failing, or a clock not yet in step with it (4),
# passes with time, and a crash may: both restart.
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=1 2 3 5 6 226
TimeoutStopSec=60

# Its state: the credential, the journal, and what its kind keeps, owner-only.
StateDirectory=@UNIT@
StateDirectoryMode=0700
UMask=0077

# The rest of the machine is read-only or absent.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
# A rootful engine's socket is root by another name: hidden here as the
# claimant starts, and out of reach if the engine makes it again, since the
# claimant holds no group but its own and the ones granted (ExecStart above).
# The host's engine is a rootless one, run as its own user
# (deployment/host/install.sh --engine rootless).
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/containerd -/run/podman

# No privilege to gain, keep, or borrow.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
